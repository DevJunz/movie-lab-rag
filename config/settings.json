{
  "paths": {
    "movies": "영화도메인_데이터_배포용/movies.json",
    "wiki_bundle": "영화도메인_데이터_배포용/movielab_wiki/wikipedia",
    "chroma_dir": "data/chroma",
    "raw_dir": "data/raw",
    "manifest": "data/manifest.json",
    "pdf_dir": "data/pdf",
    "pdf_manifest": "data/pdf/pdf_manifest.json",
    "log_file": "logs/movielab.log"
  },
  "models": {"chat": "gpt-4o-mini", "embedding": "text-embedding-3-small", "temperature": 0, "timeout_sec": 60},
  "collections": {"meta": "movie_meta", "docs": "wiki_docs", "pdf": "pdf_docs"},
  "chunking": {"chunk_size": 1000, "chunk_overlap": 200, "pdf_chunk_size": 800, "pdf_chunk_overlap": 100},
  "retrieval": {"top_k": 4, "search_type": "similarity", "mmr_fetch_k": 20, "mmr_lambda": 0.5, "pdf_top_k": 2},
  "pdf": {"min_page_chars": 50, "repeat_line_min_pages": 3},
  "indexing": {"batch_size": 100, "retries": 1, "retry_wait_sec": 2.0},
  "cache": {"lock_timeout_sec": 10.0, "lock_poll_sec": 0.01, "io_retries": 4, "io_retry_wait_sec": 0.05},
  "collect": {"card_overview_chars": 300, "snippet_chars": 200, "intro_chars": 300, "bundle_snippet_radius": 150, "bundle_body_chars": 2000, "source": "auto", "min_queries": 3, "max_queries": 5, "search_limit": 5, "max_selected_docs": 5, "min_doc_chars": 200},
  "wiki": {
    "api_url": "https://ko.wikipedia.org/w/api.php",
    "min_interval_sec": 1.0,
    "max_retries": 3,
    "backoff_base_sec": 1.0,
    "max_retry_after_sec": 60,
    "timeout_sec": 10,
    "maxlag": 5,
    "app_name": "MovieLab",
    "app_version": "0.1",
    "project_url": "https://github.com/DevJunz/movie-lab-rag"
  },
  "logging": {"max_bytes": 1048576, "backup_count": 3, "level": "INFO"},
  "ui": {"evidence_preview_chars": 200},
  "explore": {"candidates": 20, "max_results": 10},
  "domain": {"disclaimer_enabled": false}
}
